# ===== MONGODB (Get from MongoDB Atlas Free Tier) =====
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_ats?retryWrites=true&w=majority

# ===== SECURITY =====
SECRET_KEY=your_super_secret_key_for_jwt_minimum_32_characters

# ===== API SETTINGS =====
API_URL=https://ai-ats-api.onrender.com
ENVIRONMENT=production

# ===== CORS =====
ALLOWED_ORIGINS=https://your-streamlit-app.streamlit.app

# ===== STREAMLIT =====
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
